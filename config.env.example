# MiCam2 录像参数。复制为 config.env 后按需改；也可以用环境变量临时覆盖。
# install.sh 会自动帮你 cp 一份 config.env。

# ---------- 取流 ----------
# go2rtc 暴露给本机 ffmpeg 的 RTSP 地址，末尾名字要和 go2rtc.yaml 里 streams 的 key 一致
RTSP_URL="rtsp://127.0.0.1:8554/micam2"

# ---------- 落盘 ----------
# 必须在外置硬盘上。先在外置盘根目录建好这个文件夹（或让 recorder 自己建）
OUT_DIR="/Volumes/MiCam2/micam2"

# 单段时长（秒）。600 = 10 分钟/段，1 小时 6 个文件。
# 实际切片会落在关键帧上，可能比它略长（相机 GOP 通常 1~4 秒）
SEGMENT_SECONDS=600

# ---------- 容错 ----------
# ffmpeg 退出后等多久重连（秒）
RESTART_DELAY=10
# 连续失败时指数退避的上限（秒）。断网/相机离线期间别每 10 秒去小米云换一次密钥
MAX_RETRY_DELAY=300

# ---------- 自愈 ----------
# 摄像头的 MAC（`arp -an | grep <相机IP>` 可查）。看门狗用它来判断"是断电了，还是只是 IP 变了"
CAMERA_MAC="aa:bb:cc:dd:ee:ff"
# go2rtc 的 system LaunchDaemon label，看门狗重启它时用
GO2RTC_LABEL="com.micam2.go2rtc"
# RTSP 单次读超时（微秒）。15 秒没数据就认为流断了，重连
# 注意单位：ffmpeg 7.x 的 RTSP demuxer 里 -timeout 就是微秒（见 README 坑 14）
READ_TIMEOUT_US=15000000

# ---------- ffmpeg ----------
# 留空则用 PATH 里的 ffmpeg。launchd 的 PATH 很干净，常常找不到 brew 装的那个，建议写绝对路径。
# 另：ffmpeg 4.x 把 HEVC+Opus 复制进 MP4 会报 invalid extradata size、产出不可播，必须 7.x 以上。
# FFMPEG="$HOME/micam2/bin/ffmpeg"

# ---------- 保留策略 ----------
# 超过多少天就删
KEEP_DAYS=30
# 剩余空间低于该值（GB）就开始删最旧的段
MIN_FREE_GB=100
# 永远保留最近 N 个文件，防止把正在写的段删掉
PROTECT_NEWEST=3